SET optimizer = on;
SET
SET gg_planman.log_usage = notice;
SET
TRUNCATE gg_planman.plans;
TRUNCATE TABLE
=== ORCA, no hints ===
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: t2.t1_id
                           ->  Seq Scan on t2
                     ->  Hash
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
 Optimizer: GPORCA
(12 rows)

