SET client_min_messages = warning;
TRUNCATE gg_planman.plans;
DROP TABLE IF EXISTS cap_t, cap_t_new, cap_t2;
CREATE TABLE cap_t (id int, v int) DISTRIBUTED BY (id);
INSERT INTO cap_t SELECT i, i % 100 FROM generate_series(1, 10000) i;
CREATE INDEX cap_t_v_idx ON cap_t (v);
ANALYZE cap_t;
RESET client_min_messages;
SET optimizer = off;
SET
SET gg_planman.log_usage = notice;
SET
SET gg_planman.write_mode = on;
SET
=== 1. EXPLAIN with a hint comment in write mode: the plan shows the hints, nothing is stored, the warning says how to store ===
/*+ SeqScan(cap_t) */ EXPLAIN (COSTS off) SELECT count(*) FROM cap_t WHERE v < 1;
psql:22_capture_explain.sql:18: WARNING:  gg_planman: statement not captured: EXPLAIN is not stored, run the statement or call gg_planman.register_hints
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on cap_t
                     Filter: (v < 1)
 Optimizer: Postgres-based planner
(6 rows)

SELECT count(*) AS stored_rows FROM gg_planman.plans;
 stored_rows 
-------------
           0
(1 row)

