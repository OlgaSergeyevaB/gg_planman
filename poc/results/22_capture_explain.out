SET client_min_messages = warning;
CREATE TABLE cap_t_new AS SELECT * FROM cap_t DISTRIBUTED BY (id);
DROP TABLE cap_t;
ALTER TABLE cap_t_new RENAME TO cap_t;
CREATE INDEX cap_t_v_idx ON cap_t (v);
ANALYZE cap_t;
RESET client_min_messages;
