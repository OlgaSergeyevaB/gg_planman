══ 7. Временные таблицы: другая сессия, своя временная таблица ═══════════
   У временной таблицы в каждой сессии свой OID. DBA указывает её в by_name,
   и строка сопоставляется с ней по имени; без этого регистрация отклоняется.

CREATE TEMP TABLE tt AS SELECT * FROM t1 WHERE v < 2000 DISTRIBUTED BY (id);
SELECT 40000
CREATE INDEX tt_v_idx ON tt (v);
CREATE INDEX
ANALYZE tt;
ANALYZE
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM tt WHERE v = 1', 'SeqScan(tt)', by_name => '{pg_temp.tt}');
 id  |       key_base       | key_oid |          slots           
-----+----------------------+---------+--------------------------
 523 | -2662240520306124045 |         | {pg_temp.tt=schema.name}
(1 row)


-- \c: новое соединение, новая сессия, свой pg_temp
CREATE TEMP TABLE tt AS SELECT * FROM t1 WHERE v < 2000 DISTRIBUTED BY (id);
SELECT 40000
CREATE INDEX tt_v_idx ON tt (v);
CREATE INDEX
ANALYZE tt;
ANALYZE
EXPLAIN (COSTS off) SELECT count(*) FROM tt WHERE v = 20;
psql:/projects/sr_plan-poc/poc/demo.sql:188: NOTICE:  gg_planman: applying hints "SeqScan(tt)" id=523 key_base=-2662240520306124045 key_oid=-
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on tt
                     Filter: (v = 20)
 Optimizer: Postgres-based planner
(6 rows)


