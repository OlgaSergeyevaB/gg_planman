══ 8. Direct dispatch сохраняется ═══════════════════════════════════════
   Точечный запрос по ключу распределения с хинтами по-прежнему
   уходит на один сегмент: план строится с реальной константой.

SELECT * FROM gg_planman.register_hints('SELECT * FROM t1 WHERE id = 1 AND v < 1', 'IndexScan(t1 t1_v_idx)');
 id  |       key_base       |       key_oid        |      slots      
-----+----------------------+----------------------+-----------------
 542 | -3033316864868032543 | -7607778546808958193 | {public.t1=oid}
(1 row)

EXPLAIN (COSTS off) SELECT * FROM t1 WHERE id = 123 AND v < 50;
psql:/projects/sr_plan-poc/poc/demo.sql:224: NOTICE:  gg_planman: applying hints "IndexScan(t1 t1_v_idx)" id=542 key_base=-3033316864868032543 key_oid=-7607778546808958193
                QUERY PLAN                
------------------------------------------
 Gather Motion 1:1  (slice1; segments: 1)
   ->  Index Scan using t1_v_idx on t1
         Index Cond: (v < 50)
         Filter: (id = 123)
 Optimizer: GPORCA
(5 rows)


══ 9. Внутри PL/pgSQL ═══════════════════════════════════════════════════

CREATE OR REPLACE FUNCTION f_cnt(x int) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE r bigint;
BEGIN
  SELECT count(*) INTO r FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < x;
  RETURN r;
END $$;
CREATE FUNCTION
-- client_min_messages = log, чтобы auto_explain показал план вложенного запроса
SELECT f_cnt(500);
psql:/projects/sr_plan-poc/poc/demo.sql:252: LOG:  statement: SELECT f_cnt(500);
psql:/projects/sr_plan-poc/poc/demo.sql:252: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) Leading((t1 t2))" id=522 key_base=-6667503556398202216 key_oid=5104713156335499380
psql:/projects/sr_plan-poc/poc/demo.sql:252: LOG:  duration: 10.727 ms  plan:
Query Text: SELECT count(*)        FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < x
Finalize Aggregate  (cost=3448.87..3448.88 rows=1 width=8)
  ->  Gather Motion 3:1  (slice1; segments: 3)  (cost=3448.81..3448.86 rows=3 width=8)
        ->  Partial Aggregate  (cost=3448.81..3448.82 rows=1 width=8)
              ->  Nested Loop  (cost=100.52..3433.02 rows=6316 width=0)
                    ->  Broadcast Motion 3:3  (slice2; segments: 3)  (cost=100.35..389.90 rows=9518 width=4)
                          ->  Bitmap Heap Scan on t1  (cost=100.35..263.00 rows=3173 width=4)
                                Recheck Cond: (v < 500)
                                ->  Bitmap Index Scan on t1_v_idx  (cost=0.00..99.55 rows=3173 width=0)
                                      Index Cond: (v < 500)
                    ->  Index Only Scan using t2_t1_id_idx on t2  (cost=0.17..0.31 rows=1 width=4)
                          Index Cond: (t1_id = t1.id)
Optimizer: Postgres-based planner
psql:/projects/sr_plan-poc/poc/demo.sql:252: LOG:  duration: 14.806 ms  plan:
Query Text: SELECT f_cnt(500);
Result  (cost=0.00..0.26 rows=1 width=8)
Optimizer: Postgres-based planner
 f_cnt 
-------
 20000
(1 row)

psql:/projects/sr_plan-poc/poc/demo.sql:255: LOG:  statement: RESET client_min_messages;
(план вложенного запроса выше выведен auto_explain: Nested Loop по хинтам)

══ 10. ORCA: что из хинтов понимает, а что нет ═══════════════════════════

-- без хинтов
SET gg_planman.enabled = off;
SET
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: t2.t1_id
                           ->  Seq Scan on t2
                     ->  Hash
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
 Optimizer: GPORCA
(12 rows)

SET gg_planman.enabled = on;
SET

