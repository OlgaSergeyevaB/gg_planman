         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Bitmap Heap Scan on t1
                                 Recheck Cond: (v < 500)
                                 ->  Bitmap Index Scan on t1_v_idx
                                       Index Cond: (v < 500)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
 Optimizer: Postgres-based planner
(12 rows)

SHOW optimizer;
 optimizer 
-----------
 on
(1 row)


══ 11. Отключение и включение сохранённых хинтов ════════════════════════
   у строки есть id: он в результате регистрации, в строке журнала и в таблице;
   DBA переключает строку обычным UPDATE. Кэшированные планы сессий расширение
   не сбрасывает: они перестраиваются после DDL по таблице или переподключения.

SELECT id, enabled, hints FROM gg_planman.plans ORDER BY id;
 id  | enabled |                        hints                        
-----+---------+-----------------------------------------------------
 521 | t       | Set(optimizer off) NestLoop(t1 t2) Leading((t1 t2))
 522 | t       | NestLoop(t1 t2) Leading((t1 t2))
 523 | t       | SeqScan(tt)
 541 | t       | SeqScan(t1)
 542 | t       | IndexScan(t1 t1_v_idx)
(5 rows)

UPDATE gg_planman.plans SET enabled = false WHERE id = (SELECT min(id) FROM gg_planman.plans WHERE query = 'SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 1');
UPDATE 1
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: t2.t1_id
                           ->  Seq Scan on t2
                     ->  Hash
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
 Optimizer: GPORCA
(12 rows)


══ 12. Таблицы по имени и по шаблону ════════════════════════════════════
   Обычно строка сопоставляется с таблицами запроса по OID. В by_name DBA
   называет таблицы, которые сопоставляются по имени, в by_regex — по
   регулярному выражению: одна строка обслуживает все подходящие таблицы.

SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM sales_2026 s WHERE s.v < 1', 'SeqScan(s)', by_regex => '{^public\\.sales_}');
 id  |      key_base      | key_oid |                     slots                     
-----+--------------------+---------+-----------------------------------------------
 543 | 230948756002631127 |         | {"public.sales_2026=regex(^public\\.sales_)"}
(1 row)

EXPLAIN (COSTS off) SELECT count(*) FROM sales_2025 s WHERE s.v < 50;
psql:/projects/sr_plan-poc/poc/demo.sql:333: NOTICE:  gg_planman: applying hints "SeqScan(s)" id=543 key_base=230948756002631127 key_oid=-4876514999277291275
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on sales_2025 s
                     Filter: (v < 50)
 Optimizer: Postgres-based planner
(6 rows)


-- строка с точным именем специфичнее шаблона, а строка по OID специфичнее обеих
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM sales_2026 s WHERE s.v < 1', 'IndexScan(s sales_2026_v_idx)', by_name => '{sales_2026}');
