
╔══════════════════════════════════════════════════════════════════════╗
║  PoC gg_planman на Greengage 7: к запросу хранятся хинты pg_hint_plan  ║
║  t1 — 200 000 строк, DISTRIBUTED BY (id), индекс по v                ║
║  t2 — 400 000 строк, DISTRIBUTED BY (id), индекс по t1_id            ║
╚══════════════════════════════════════════════════════════════════════╝

Настройки сессии: gg_planman.log_usage = notice — видно каждое применение хинтов.

══ 1. Проблема: план, который выбирает планировщик Postgres ═══════════════

EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 100)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 100)
 Optimizer: Postgres-based planner
(13 rows)


══ 2. Захват: DBA один раз выполняет запрос с комментарием-хинтом ════════
   gg_planman.write_mode = on: комментарий /*+ ... */ сохраняется в gg_planman.plans
   вместе с текстом запроса и списком объектов, от которых запрос зависит.

/*+ NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2)) */
SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100;
psql:/projects/sr_plan-poc/poc/demo.sql:53: NOTICE:  gg_planman: stored hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=521 key_base=1110863247016496802 key_oid=-85918446321826985
 count 
-------
  4000
(1 row)


Что сохранилось:
      key_base       |      key_oid       |                          hints                          | relnames |    reloids    
---------------------+--------------------+---------------------------------------------------------+----------+---------------
 1110863247016496802 | -85918446321826985 | NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2)) | {t1,t2}  | {79426,79431}
(1 row)


══ 3. Применение: тот же запрос, другая константа, без комментария ═══════
   Ключ не содержит значений констант, поэтому v < 500 находит хинты,
   сохранённые для v < 100. План строится заново с реальной константой.

EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:/projects/sr_plan-poc/poc/demo.sql:71: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=521 key_base=1110863247016496802 key_oid=-85918446321826985
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
 Optimizer: Postgres-based planner
(10 rows)


Результат с хинтами и без них одинаковый:
SELECT count(*) AS with_hints FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:/projects/sr_plan-poc/poc/demo.sql:76: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=521 key_base=1110863247016496802 key_oid=-85918446321826985
 with_hints 
------------
      20000
(1 row)

SET gg_planman.enabled = off;
SET
SELECT count(*) AS without_hints FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
 without_hints 
---------------
         20000
(1 row)

SET gg_planman.enabled = on;
SET

══ 3а. Запрос со своими хинтами в комментарии ════════════════════════════
   Хинты, явно написанные в тексте запроса, главнее сохранённых:
   применяются они, а сохранённая строка остаётся как была.

/*+ HashJoin(t1 t2) */ EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:/projects/sr_plan-poc/poc/demo.sql:91: NOTICE:  gg_planman: hints of the query text applied, stored hints not used id=521 key_base=1110863247016496802 key_oid=-85918446321826985
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 500)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 500)
 Optimizer: Postgres-based planner
(13 rows)


══ 4. Ключ запроса: что игнорируется, а что нет ══════════════════════════
   gg_planman.query_key() считает ключи для текста запроса, ничего не выполняя.

            вариант запроса            |       key_base       |       key_oid        
---------------------------------------+----------------------+----------------------
 исходный: v < 100                     |  1110863247016496802 |   -85918446321826985
 другая константа: v < 999999          |  1110863247016496802 |   -85918446321826985
 другое форматирование и регистр       |  1110863247016496802 |   -85918446321826985
 имена со схемой public.t1             |  1110863247016496802 |   -85918446321826985
 алиасы a, b — другой ключ             | -8572375589231877517 | -4718039728481658228
 параметр $1 — другой ключ             | -6667503556398202216 |  4996626765278607466
 литерал 100.0 (numeric) — другой ключ | -5831913900761244942 |  6673810626629097343
(7 rows)

Строки 1–4 совпадают: константы, форматирование и схема в ключи не входят.
key_base не содержит таблиц вовсе, key_oid — свёртка key_base с OID таблиц запроса.
Алиасы входят намеренно: pg_hint_plan адресует таблицы по алиасу.

══ 5. Регистрация без выполнения запроса: prepared statement ═════════════
   Приложение шлёт запрос с параметром $1. DBA регистрирует хинты
   по тексту с $1 и типом параметра — сам запрос выполнять не нужно.

PREPARE p(int) AS SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1;
PREPARE
EXPLAIN (COSTS off) EXECUTE p(100);
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 100)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 100)
 Optimizer: Postgres-based planner
(13 rows)

SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1', 'NestLoop(t1 t2) Leading((t1 t2))', '{int4}');
 id  |       key_base       |       key_oid       |             slots             
-----+----------------------+---------------------+-------------------------------
 522 | -6667503556398202216 | 4996626765278607466 | {public.t1=oid,public.t2=oid}
(1 row)

EXPLAIN (COSTS off) EXECUTE p(100);
psql:/projects/sr_plan-poc/poc/demo.sql:126: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) Leading((t1 t2))" id=522 key_base=-6667503556398202216 key_oid=4996626765278607466
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Bitmap Heap Scan on t1
                                 Recheck Cond: (v < 100)
                                 ->  Bitmap Index Scan on t1_v_idx
                                       Index Cond: (v < 100)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
 Optimizer: Postgres-based planner
(12 rows)

DEALLOCATE

══ 6. Таблица пересоздана: служебная проверка показывает, какие хинты не работают ══
   Строка сопоставляется с таблицей по OID. Когда таблицу удаляют, зависящие от неё
   строки по OID перестают применяться; gg_planman.check() показывает их с причиной,
   ничего не записывая в хранилище, а check(regenerate => true) регистрирует заново.

Ночная загрузка пересоздала t1: новая таблица, то же имя, тот же индекс.

EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:/projects/sr_plan-poc/poc/demo.sql:152: NOTICE:  gg_planman: stored hints not applied id=521: table public.t1 was recreated, run gg_planman.check(regenerate => true) key_base=1110863247016496802 key_oid=-410177619492502695
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 500)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 500)
 Optimizer: Postgres-based planner
(13 rows)

SELECT identity, state, reason FROM gg_planman.check();
      identity       |  state  |            reason             
---------------------+---------+-------------------------------
 oid:79426 oid:79431 | invalid | table public.t1 was recreated
 oid:79426 oid:79431 | invalid | table public.t1 was recreated
(2 rows)


-- перегенерация одной командой: текст запроса и типы параметров уже в хранилище
SELECT identity, state, reason FROM gg_planman.check(regenerate => true);
      identity       |    state    |            reason             
---------------------+-------------+-------------------------------
 oid:79426 oid:79431 | regenerated | table public.t1 was recreated
 oid:79426 oid:79431 | regenerated | table public.t1 was recreated
(2 rows)

SELECT id, hints, reloids::text FROM gg_planman.plans ORDER BY created_at;
 id  |                          hints                          |    reloids    
-----+---------------------------------------------------------+---------------
 521 | NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2)) | {79436,79431}
 522 | NestLoop(t1 t2) Leading((t1 t2))                        | {79436,79431}
(2 rows)

EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:/projects/sr_plan-poc/poc/demo.sql:160: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=521 key_base=1110863247016496802 key_oid=-410177619492502695
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
