SET optimizer = off;
SET
SET gg_planman.log_usage = notice;
SET
TRUNCATE gg_planman.plans;
TRUNCATE TABLE
PREPARE p(int) AS SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1;
PREPARE
=== hints registered for the literal form only ===
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100', 'NestLoop(t1 t2) Leading((t1 t2))');
 id  |      key_base       |       key_oid       |             slots             
-----+---------------------+---------------------+-------------------------------
 481 | 1110863247016496802 | -356134423964054633 | {public.t1=oid,public.t2=oid}
(1 row)

EXPLAIN (COSTS off) EXECUTE p(100);
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 100)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 100)
 Optimizer: Postgres-based planner
(13 rows)

=== hints registered for the parameter form ===
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1', 'NestLoop(t1 t2) Leading((t1 t2))', '{int4}');
 id  |       key_base       |       key_oid       |             slots             
-----+----------------------+---------------------+-------------------------------
 482 | -6667503556398202216 | 5122727554844966692 | {public.t1=oid,public.t2=oid}
(1 row)

EXPLAIN (COSTS off) EXECUTE p(100);
psql:06_prepared.sql:16: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) Leading((t1 t2))" id=482 key_base=-6667503556398202216 key_oid=5122727554844966692
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Bitmap Heap Scan on t1
                                 Recheck Cond: (v < 100)
                                 ->  Bitmap Index Scan on t1_v_idx
                                       Index Cond: (v < 100)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
 Optimizer: Postgres-based planner
(12 rows)

=== a generic plan cached before the registration stays unhinted: no invalidation by the extension ===
DEALLOCATE p;
DEALLOCATE
TRUNCATE gg_planman.plans;
TRUNCATE TABLE
SET plan_cache_mode = force_generic_plan;
SET
PREPARE p(int) AS SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1;
PREPARE
EXECUTE p(100);
