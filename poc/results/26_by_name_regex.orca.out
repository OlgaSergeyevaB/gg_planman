=== 9. a selector in by_name and a pattern in by_regex on one query: what the row keeps ===
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM data_2026 d JOIN bn_dim m ON m.id = d.id JOIN bn_tmp t ON t.id = d.id WHERE d.v < 5', 'Leading((t (d m))) HashJoin(d m) SeqScan(t)', by_name => '{~^pg_temp\\.}', by_regex => '{^public\\.data_}');
 id  |       key_base       | key_oid |                                          slots                                           
-----+----------------------+---------+------------------------------------------------------------------------------------------
 466 | -1096119743559110075 |         | {"public.data_2026=regex(^public\\.data_)",public.bn_dim=oid,pg_temp.bn_tmp=schema.name}

SELECT key_oid, relschemas, relnames, reloids::text, rules, patterns, n_oid, n_name, n_regex, identity, by_name, by_regex FROM gg_planman.plans WHERE 'bn_tmp' = ANY(relnames) AND 'data_2026' = ANY(relnames);
 key_oid |       relschemas        |         relnames          |      reloids       |          rules          |           patterns            | n_oid | n_name | n_regex |                       identity                       |     by_name      |      by_regex       
---------+-------------------------+---------------------------+--------------------+-------------------------+-------------------------------+-------+--------+---------+------------------------------------------------------+------------------+---------------------
         | {public,public,pg_temp} | {data_2026,bn_dim,bn_tmp} | {79388,79379,NULL} | {regex,oid,schema.name} | {"^public\\.data_",NULL,NULL} |     1 |      1 |       1 | regex:^public\.data_ oid:79379 schema:pg_temp.bn_tmp | {"~^pg_temp\\."} | {"^public\\.data_"}

EXPLAIN (COSTS off) SELECT count(*) FROM data_2025 d JOIN bn_dim m ON m.id = d.id JOIN bn_tmp t ON t.id = d.id WHERE d.v < 9;
psql:26_by_name_regex.sql:95: NOTICE:  gg_planman: applying hints "Leading((t (d m))) HashJoin(d m) SeqScan(t)" id=466 key_base=-1096119743559110075 key_oid=-
                                     QUERY PLAN                                      
-------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: ((t.id = d.id) AND (t.id = m.id))
                     ->  Seq Scan on bn_tmp t
                     ->  Hash
                           ->  Hash Join
                                 Hash Cond: (d.id = m.id)
                                 ->  Index Scan using data_2025_v_idx on data_2025 d
                                       Index Cond: (v < 9)
                                 ->  Hash
                                       ->  Seq Scan on bn_dim m
 Optimizer: GPORCA

