=== 3.2 a table matched by name: the load recreates orders, and the hints stay in use without regeneration ===
SELECT * FROM gg_planman.register_hints($q$
    SELECT c.region, count(*)
      FROM customers c JOIN orders o ON o.customer_id = c.id
     WHERE o.order_date >= '2026-09-01' AND o.amount > 900
     GROUP BY c.region
$q$, 'SeqScan(o)', by_name => '{orders}');
 id  |      key_base       | key_oid |                   slots                   
-----+---------------------+---------+-------------------------------------------
 421 | 1536521606010585085 |         | {public.customers=oid,public.orders=name}

