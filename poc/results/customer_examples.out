                      QUERY PLAN                       
-------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Seq Scan on orders_2025 o
                     Filter: (amount > '995'::numeric)
 Optimizer: GPORCA

SELECT rules, patterns FROM gg_planman.plans WHERE 'orders_2026' = ANY(relnames);
