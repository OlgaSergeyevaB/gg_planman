SELECT q, key_base, key_oid FROM (
          SELECT 1 AS n, 'captured: v < 100' AS q, * FROM gg_planman.query_key('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100')
UNION ALL SELECT 2, 'other constant: v < 999999', * FROM gg_planman.query_key('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 999999')
UNION ALL SELECT 3, 'formatting and case', * FROM gg_planman.query_key(E'select COUNT(*)\n   from T1 join T2 on T1.ID=T2.T1_ID\n  where T1.V<100')
UNION ALL SELECT 4, 'schema-qualified names', * FROM gg_planman.query_key('SELECT count(*) FROM public.t1 JOIN public.t2 ON t1.id = t2.t1_id WHERE t1.v < 100')
UNION ALL SELECT 5, 'aliases a, b', * FROM gg_planman.query_key('SELECT count(*) FROM t1 a JOIN t2 b ON a.id = b.t1_id WHERE a.v < 100')
UNION ALL SELECT 6, 'quoted literal ''100''', * FROM gg_planman.query_key('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < ''100''')
UNION ALL SELECT 7, 'numeric literal 100.0', * FROM gg_planman.query_key('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100.0')
UNION ALL SELECT 8, 'parameter $1 int4', * FROM gg_planman.query_key('SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < $1', '{int4}')
UNION ALL SELECT 9, 'join order swapped in FROM', * FROM gg_planman.query_key('SELECT count(*) FROM t2 JOIN t1 ON t1.id = t2.t1_id WHERE t1.v < 100')
UNION ALL SELECT 10, 'IN (1,2)', * FROM gg_planman.query_key('SELECT count(*) FROM t1 WHERE v IN (1,2)')
UNION ALL SELECT 11, 'IN (1,2,3)', * FROM gg_planman.query_key('SELECT count(*) FROM t1 WHERE v IN (1,2,3)')
UNION ALL SELECT 12, '= ANY(ARRAY[1,2,3])', * FROM gg_planman.query_key('SELECT count(*) FROM t1 WHERE v = ANY(ARRAY[1,2,3])')
UNION ALL SELECT 13, 'LIMIT 10', * FROM gg_planman.query_key('SELECT * FROM t1 WHERE v < 5 LIMIT 10')
UNION ALL SELECT 14, 'LIMIT 100000', * FROM gg_planman.query_key('SELECT * FROM t1 WHERE v < 5 LIMIT 100000')
) s ORDER BY n;
             q              |       key_base       |       key_oid        
----------------------------+----------------------+----------------------
 captured: v < 100          |  1110863247016496802 |  5750746670750338341
 other constant: v < 999999 |  1110863247016496802 |  5750746670750338341
 formatting and case        |  1110863247016496802 |  5750746670750338341
 schema-qualified names     |  1110863247016496802 |  5750746670750338341
 aliases a, b               | -8572375589231877517 | -2196023937154180450
 quoted literal '100'       |  1110863247016496802 |  5750746670750338341
 numeric literal 100.0      | -5831913900761244942 |  1990067014163779949
 parameter $1 int4          | -6667503556398202216 | -8478143319813916564
 join order swapped in FROM | -6288159748786515242 | -7279192702624781587
 IN (1,2)                   | -3694307437251664969 |  -846318501630964129
 IN (1,2,3)                 |  8951673227297129680 |   190225461401367034
