SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:01_capture_apply.sql:21: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=201 key_base=1110863247016496802 key_oid=5750746670750338341
