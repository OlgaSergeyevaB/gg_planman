SET client_min_messages = notice;
SET
SET gg_planman.log_usage = notice;
SET
TRUNCATE gg_planman.plans;
TRUNCATE TABLE
=== Postgres planner, no hints ===
SET optimizer = off;
SET
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 100)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 100)
 Optimizer: Postgres-based planner
(13 rows)

=== capture: DBA runs the query once with a hint comment ===
SET gg_planman.write_mode = on;
SET
/*+ NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2)) */
SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 100;
psql:01_capture_apply.sql:13: NOTICE:  gg_planman: stored hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=201 key_base=1110863247016496802 key_oid=5750746670750338341
 count 
-------
  4000
(1 row)

SET gg_planman.write_mode = off;
SET
