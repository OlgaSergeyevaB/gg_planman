SET gg_planman.log_usage = notice;
SET
SET optimizer = on;
SET
SET optimizer_trace_fallback = on;
SET
TRUNCATE gg_planman.plans;
TRUNCATE TABLE
=== query that ORCA cannot plan: TABLESAMPLE ===
SET gg_planman.enabled = off;
SET
EXPLAIN (COSTS off) SELECT count(*) FROM t1 TABLESAMPLE SYSTEM (50) JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:12_fallback.sql:7: INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: TABLESAMPLE in the FROM clause
