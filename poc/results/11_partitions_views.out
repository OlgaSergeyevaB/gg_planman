=== view over the join ===
SET optimizer = off;
SET
CREATE OR REPLACE VIEW v_join AS SELECT t1.v, t2.w FROM t1 JOIN t2 ON t1.id = t2.t1_id;
CREATE VIEW
SELECT * FROM gg_planman.register_hints('SELECT count(*) FROM v_join WHERE v < 1', 'NestLoop(t1 t2) Leading((t1 t2))');
