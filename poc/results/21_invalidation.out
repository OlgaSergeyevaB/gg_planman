         ->  Partial Aggregate
               ->  Append
                     ->  Seq Scan on pt_1_prt_1
                           Filter: (v = 7)
                     ->  Seq Scan on pt_1_prt_2
                           Filter: (v = 7)
                     ->  Seq Scan on pt_1_prt_3
                           Filter: (v = 7)
                     ->  Seq Scan on pt_1_prt_11
                           Filter: (v = 7)
 Optimizer: Postgres-based planner
(13 rows)

=== 8. one row by its id: check(row_id => ...) examines and regenerates that row only ===
CREATE TABLE one_t (id int, v int) DISTRIBUTED BY (id);
CREATE TABLE
CREATE TABLE two_t (id int, v int) DISTRIBUTED BY (id);
CREATE TABLE
SELECT id AS one_id FROM gg_planman.register_hints('SELECT count(*) FROM one_t WHERE v = 1', 'SeqScan(one_t)') 
SELECT id AS two_id FROM gg_planman.register_hints('SELECT count(*) FROM two_t WHERE v = 1', 'SeqScan(two_t)') 
DROP TABLE one_t, two_t;
DROP TABLE
CREATE TABLE one_t (id int, v int) DISTRIBUTED BY (id);
CREATE TABLE
CREATE TABLE two_t (id int, v int) DISTRIBUTED BY (id);
CREATE TABLE
--- both tables were recreated; the check by id reports the row over one_t only
SELECT id, state, reason FROM gg_planman.check(row_id => 266);
 id  |  state  |              reason              
-----+---------+----------------------------------
 266 | invalid | table public.one_t was recreated
(1 row)

--- regeneration of that row only; the id stays, the row over two_t is untouched
SELECT id, state, reason FROM gg_planman.check(regenerate => true, row_id => 266);
 id  |    state    |              reason              
-----+-------------+----------------------------------
 266 | regenerated | table public.one_t was recreated
(1 row)

SELECT id, reloids::text, (SELECT oid FROM pg_class WHERE relname = relnames[1])::text AS current_oid FROM gg_planman.plans WHERE id IN (266, 267) ORDER BY id;
 id  | reloids | current_oid 
-----+---------+-------------
 266 | {79253} | 79253
 267 | {79250} | 79256
(2 rows)

--- an id without a row is an error
SELECT id, state, reason FROM gg_planman.check(row_id => 0);
psql:21_invalidation.sql:127: ERROR:  no stored row with id 0
CONTEXT:  PL/pgSQL function gg_planman."check"(boolean,bigint) line 13 at RAISE
--- the full check still finds the row over two_t
SELECT id, state, reason FROM gg_planman.check() WHERE id IN (266, 267) ORDER BY id;
 id  |  state  |              reason              
-----+---------+----------------------------------
 266 | valid   | 
 267 | invalid | table public.two_t was recreated
(2 rows)

SET client_min_messages = warning;
DROP TABLE IF EXISTS kt, pt, one_t, two_t CASCADE;
DROP FUNCTION IF EXISTS kf(int);
TRUNCATE gg_planman.plans;
