=== 1. t1 is recreated by an ETL-style swap: the rows by OID stop applying, the check reports them ===
CREATE TABLE t1_new AS SELECT * FROM t1 DISTRIBUTED BY (id);
SELECT 200000
DROP TABLE t1;
DROP TABLE
ALTER TABLE t1_new RENAME TO t1;
ALTER TABLE
CREATE INDEX t1_v_idx ON t1 (v);
CREATE INDEX
ANALYZE t1;
ANALYZE
--- the row is not applied and the log names the replaced table
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:21_invalidation.sql:43: NOTICE:  gg_planman: stored hints not applied id=261: table public.t1 was recreated, run gg_planman.check(regenerate => true) key_base=1110863247016496802 key_oid=4868041143785721110
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 500)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 500)
 Optimizer: Postgres-based planner
(13 rows)

--- the check reports the rows with the reason and writes nothing: in a read-only transaction it answers the same
SELECT identity, state, reason FROM gg_planman.check();
      identity       |  state  |            reason             
---------------------+---------+-------------------------------
 oid:79200 oid:79205 | invalid | table public.t1 was recreated
 oid:79200           | invalid | table public.t1 was recreated
 oid:79210           | valid   | 
 oid:79210           | valid   | 
(4 rows)

BEGIN READ ONLY;
BEGIN
SELECT identity, state, reason FROM gg_planman.check();
      identity       |  state  |            reason             
---------------------+---------+-------------------------------
 oid:79200 oid:79205 | invalid | table public.t1 was recreated
 oid:79200           | invalid | table public.t1 was recreated
 oid:79210           | valid   | 
 oid:79210           | valid   | 
(4 rows)

COMMIT;
COMMIT
--- the log line goes on until the row is regenerated
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:21_invalidation.sql:50: NOTICE:  gg_planman: stored hints not applied id=261: table public.t1 was recreated, run gg_planman.check(regenerate => true) key_base=1110863247016496802 key_oid=4868041143785721110
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Hash Join
                     Hash Cond: (t2.t1_id = t1.id)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  Bitmap Heap Scan on t1
                                       Recheck Cond: (v < 500)
                                       ->  Bitmap Index Scan on t1_v_idx
                                             Index Cond: (v < 500)
 Optimizer: Postgres-based planner
(13 rows)

--- regeneration from the stored text and parameter types; the ids stay
SELECT identity, state, reason FROM gg_planman.check(regenerate => true);
      identity       |    state    |            reason             
---------------------+-------------+-------------------------------
 oid:79200 oid:79205 | regenerated | table public.t1 was recreated
 oid:79200           | regenerated | table public.t1 was recreated
 oid:79210           | valid       | 
 oid:79210           | valid       | 
(4 rows)

SELECT id, left(query, 42) AS query, reloids::text FROM gg_planman.plans ORDER BY created_at;
 id  |                   query                    |    reloids    
-----+--------------------------------------------+---------------
 263 | SELECT count(*) FROM kt WHERE c < 1        | {79210}
 264 | SELECT count(*) FROM kt WHERE kf(a) < 1    | {79210}
 261 | SELECT count(*) FROM t1 JOIN t2 ON t1.id = | {79215,79205}
 262 | SELECT count(*) FROM t1 WHERE v < $1       | {79215}
(4 rows)

EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:21_invalidation.sql:54: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) Leading((t1 t2))" id=261 key_base=1110863247016496802 key_oid=4868041143785721110
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Bitmap Heap Scan on t1
                                 Recheck Cond: (v < 500)
                                 ->  Bitmap Index Scan on t1_v_idx
                                       Index Cond: (v < 500)
