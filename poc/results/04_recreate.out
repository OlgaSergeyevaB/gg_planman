=== before recreation ===
EXPLAIN (COSTS off) SELECT count(*) FROM t1 JOIN t2 ON t1.id = t2.t1_id WHERE t1.v < 500;
psql:04_recreate.sql:6: NOTICE:  gg_planman: applying hints "NestLoop(t1 t2) IndexScan(t1 t1_v_idx) Leading((t1 t2))" id=201 key_base=1110863247016496802 key_oid=5750746670750338341
                             QUERY PLAN                              
---------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Partial Aggregate
               ->  Nested Loop
                     ->  Broadcast Motion 3:3  (slice2; segments: 3)
                           ->  Index Scan using t1_v_idx on t1
                                 Index Cond: (v < 500)
                     ->  Index Only Scan using t2_t1_id_idx on t2
                           Index Cond: (t1_id = t1.id)
 Optimizer: Postgres-based planner
(10 rows)

=== recreate t1 as ETL does: new table, same name, same index name ===
CREATE TABLE t1_new (id int, v int, pad text) DISTRIBUTED BY (id);
CREATE TABLE
INSERT INTO t1_new SELECT * FROM t1;
INSERT 0 200000
DROP TABLE t1;
DROP TABLE
ALTER TABLE t1_new RENAME TO t1;
ALTER TABLE
CREATE INDEX t1_v_idx ON t1 (v);
CREATE INDEX
ANALYZE t1;
ANALYZE
=== after recreation: the row still carries the old reloids and is not applied ===
SELECT hints, reloids::text, (SELECT array_agg(oid ORDER BY relname)::text FROM pg_class WHERE relname IN ('t1','t2')) AS current_oids FROM gg_planman.plans;
